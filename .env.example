DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL. Leave unset to use a local SQLite file for development.
DATABASE_URL=postgres://zerotrace:zerotrace@localhost:5432/zerotrace
DEFAULT_FROM_EMAIL=ZeroTrace Academy <noreply@localhost>
# Optional SMTP. Without it, messages are printed to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Google sign-in. Create an OAuth web client and allow this redirect:
# http://127.0.0.1:8000/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
