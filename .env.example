# Copy the variables you need into your environment (or a process manager / .env loader).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Leave POSTGRES_DB unset to use SQLite (db.sqlite3) for local development.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
